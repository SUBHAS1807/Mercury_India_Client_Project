# ============================================================
# Mercury India Compliance - Environment Configuration
# ============================================================

# Server Port
PORT=3000

# WhatsApp Contact Configuration
# Provide international number without spaces or symbols (e.g., 919830839926)
WHATSAPP_NUMBER=919830839926
WHATSAPP_MESSAGE=Hello, I would like to know more about your services.

# Notification Email (Enquiries recipient)
ADMIN_EMAIL=info@mercuryindiaappliance.com

# Optional SMTP Settings for automated email dispatch
# (If omitted, enquiries are stored locally in data/enquiries.json)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mercury India Compliance" <notifications@mercuryindiaappliance.com>
